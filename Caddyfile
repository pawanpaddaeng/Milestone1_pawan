# Terminates TLS in front of the backend. Caddy fetches and renews a Let's
# Encrypt certificate automatically (ports 80 and 443 must be open).
# SERVER_IP comes from backend/.env (see docker-compose.yml). sslip.io resolves
# <ip>.sslip.io to <ip>, so no DNS setup is needed.
{$SERVER_IP}.sslip.io {
	# wss://DOMAIN/ws -> WebSocket server
	handle_path /ws* {
		reverse_proxy backend:8080
	}

	# https://DOMAIN/... -> REST API
	handle {
		reverse_proxy backend:3000
	}
}
